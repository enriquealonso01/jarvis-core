{
  "name": "jarvis-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "runner": "node dist/runner.js",
    "dev": "node --import tsx src/index.ts",
    "migrate": "node dist/migrate.js",
    "dev:up": "docker compose -f deploy/compose.dev.yaml up -d --build",
    "dev:down": "docker compose -f deploy/compose.dev.yaml down -v",
    "dev:seed": "docker compose -f deploy/compose.dev.yaml run --rm seed",
    "dev:test": "bash scripts/s1-harness-test.sh",
    "dev:test:s2": "bash scripts/s2-task-create-test.sh",
    "dev:test:s3": "bash scripts/s3-routing-test.sh",
    "dev:test:s3b": "bash scripts/s3b-split-test.sh",
    "dev:rebuild": "bash scripts/dev-rebuild.sh",
    "dev:test:s3c": "bash scripts/s3c-context-test.sh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.1.1",
    "argon2": "^0.44.0",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  }
}
