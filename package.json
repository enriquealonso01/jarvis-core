{
  "name": "jarvis-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "runner": "node dist/runner.js",
    "dev": "node --import tsx src/index.ts",
    "migrate": "node dist/migrate.js",
    "dev:up": "docker compose -f deploy/compose.dev.yaml up -d --build",
    "dev:down": "docker compose -f deploy/compose.dev.yaml down -v",
    "dev:seed": "docker compose -f deploy/compose.dev.yaml run --rm seed",
    "dev:test": "bash scripts/s1-harness-test.sh",
    "dev:test:s2": "bash scripts/s2-task-create-test.sh",
    "dev:test:s3": "bash scripts/s3-routing-test.sh",
    "dev:test:s3b": "bash scripts/s3b-split-test.sh",
    "dev:rebuild": "bash scripts/dev-rebuild.sh",
    "dev:test:s3c": "bash scripts/s3c-context-test.sh",
    "dev:test:s4": "bash scripts/s4-recovery-test.sh",
    "dev:test:s4drain": "bash scripts/s4-drain-test.sh",
    "progress": "node scripts/progress-sync.mjs",
    "progress:publish": "bash scripts/progress-publish.sh",
    "dev:test:s5": "bash scripts/s5-isolation-test.sh",
    "dev:test:s6": "bash scripts/s6-workflow-test.sh",
    "dev:test:s7": "bash scripts/s7-pullrequest-test.sh",
    "dev:test:n1": "python scripts/acceptance-runner.py --only n1 || python -c \"import sys,pathlib;sys.path.insert(0,str(pathlib.Path('scripts').resolve()));from s8_n1 import run_n1;r=[];run_n1(lambda i,t,p,dt:(r.append(p),print(('PASS' if p else 'FAIL'),i,t,dt)),lambda *a:None);sys.exit(0 if all(r) else 1)\"",
    "dev:test:s9": "bash scripts/s9-review-test.sh",
    "dev:burst": "bash scripts/burst-repro.sh",
    "dev:test:s10": "bash scripts/s10-grants-test.sh",
    "dev:test:s11": "bash scripts/s11-recovery-test.sh",
    "dev:test:s12": "bash scripts/s12-isolation-test.sh",
    "dev:test:s13": "bash scripts/s13-home-test.sh",
    "dev:test:s14": "bash scripts/s14-live-detail-test.sh",
    "dev:test:s15": "bash scripts/s15-console-test.sh",
    "dev:test:l17": "node scripts/s15-journeys-test.mjs",
    "dev:test:s16": "bash scripts/s16-credential-test.sh",
    "dev:test:s17": "bash scripts/s17-artifacts-test.sh",
    "dev:test:s18": "bash scripts/s18-search-test.sh",
    "dev:test:s18b": "bash scripts/s18b-retrofit-test.sh",
    "dev:test:all": "bash scripts/sweep.sh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.1.1",
    "argon2": "^0.44.0",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "playwright-core": "^1.62.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  }
}
