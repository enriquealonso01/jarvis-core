# The dev image (plan S1).
#
# Deliberately NOT the production Dockerfile: that one installs
# @anthropic-ai/claude-code, and the whole point of S1 is that the engineering
# loop can be run by someone with no Claude subscription. It also keeps dev
# dependencies so `tsx` can run the seed script, and adds git, which the runner
# needs for worktrees.
FROM node:22-bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ git openssh-client ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.15.1 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY packages ./packages
RUN pnpm install --frozen-lockfile
COPY src ./src
COPY scripts ./scripts
COPY migrations ./migrations
# In production the API reads this from the deployed source tree at
# /opt/jarvis/core, bind-mounted read-only. Dev has no such tree, so /app is it.
COPY PROGRESS.json ./
RUN pnpm build
# A worktree created by the runner must not look "dubiously owned" to git when
# the seed script and the runner disagree about uid. This is a throwaway box.
RUN git config --system --add safe.directory '*'
ENV NODE_ENV=development
EXPOSE 8080
CMD ["node", "dist/index.js"]
