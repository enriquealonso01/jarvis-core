# /etc/jarvis/runner.env — 0640 root:jarvis
#
# The heavy-lane runner's ONLY secret. Not the master key, not the compose env,
# not the provider keys: the runner reaches the database and nothing else, and a
# file the jarvis user can read is a file a compromised harness can read.
#
# Install:
#   sudo install -o root -g jarvis -m 0640 runner.env.example /etc/jarvis/runner.env
#   sudo sed -i "s|REPLACE_ME|<the POSTGRES_PASSWORD from /etc/jarvis/compose.env>|" /etc/jarvis/runner.env
#
# Postgres publishes on 127.0.0.1:5432 (deploy/compose.yaml). The in-container
# hostname `postgres` does not resolve out here, so the host and port are
# explicit.
DATABASE_URL=postgres://jarvis:REPLACE_ME@127.0.0.1:5432/jarvis
