{
	email alonsorequejoenrique@gmail.com
}

jarvis.enriquecodes.com {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	handle /webhooks/telnyx {
		reverse_proxy api:8080
	}

	# The build bar's state. Served by the API from the deployed source tree,
	# NOT from a copy under the static root: that copy was published by hand,
	# went stale, and the console deploy's `rsync --delete` removed it. Routing
	# it here also means it arrives with an explicit UTF-8 charset.
	handle /PROGRESS.json {
		reverse_proxy api:8080
	}

	# The reasons behind the counts. Without this block /BLOCKED.md fell through
	# to the static site, whose try_files ends at /index.html, so the "why" link
	# under the blocked and awaiting counts answered with the dashboard itself -
	# a 200, an HTML page, and no way to tell from the outside that it was broken.
	handle /BLOCKED.md {
		reverse_proxy api:8080
	}

	handle {
		root * /srv/www
		try_files {path} {path}/ {path}.html /index.html
		file_server
	}
}
